# Copy this file to secrets.toml for local use, or paste its contents into
# Streamlit Cloud -> App settings -> Secrets. Use ONE of the two variants
# below. Without a [gsheets] section the app falls back to local CSVs in data/.

# ---------------------------------------------------------------------------
# VARIANT A — OAuth user credentials (works even when service-account key
# creation is blocked). Generate the three values by running:
#     python scripts/get_google_token.py path/to/client_secret.json
# ---------------------------------------------------------------------------

[gsheets]
spreadsheet = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"
client_id = "123456789012-abcdefg.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxxxxxxxxxxxxxx"
refresh_token = "1//0gxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# VARIANT B — service-account key (if your account can create JSON keys).
# Fill every value from the downloaded service-account JSON, plus the sheet
# URL, and share the sheet with client_email as Editor.
# ---------------------------------------------------------------------------

# [gsheets]
# spreadsheet = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"
# type = "service_account"
# project_id = "your-project-id"
# private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# private_key = "-----BEGIN PRIVATE KEY-----\nMIIE...rest of key...\n-----END PRIVATE KEY-----\n"
# client_email = "calorie-app@your-project-id.iam.gserviceaccount.com"
# client_id = "123456789012345678901"
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/calorie-app%40your-project-id.iam.gserviceaccount.com"
